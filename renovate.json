{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "reviewers": [
    "FournyP"
  ],
  "packageRules": [
    {
      "description": "Minor and patch updates automerge once every check passes.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": true
    },
    {
      "description": "Exception: on 0.x a minor bump can break, so it needs a human.",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
