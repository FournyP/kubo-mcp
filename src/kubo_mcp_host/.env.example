# Copy to `.env`. SECTION__FIELD maps to the `section.field` setting.

# --- Logging -----------------------------------------------------------------
LOGGING__LEVEL=info

# --- Host --------------------------------------------------------------------
HOST__PORT=3000

# --- Auth (empty keeps /mcp open) -------------------------------------------
AUTH__API_KEYS=

# --- MCP (empty exposes every tool) -----------------------------------------
MCP__ENABLED_TOOLS=

# --- Kubo RPC API ------------------------------------------------------------
KUBO__API_URL=http://127.0.0.1:5001
KUBO__AUTHORIZATION=
KUBO__REQUEST_TIMEOUT=60s
KUBO__UPLOAD_TIMEOUT=10m

# --- IPFS --------------------------------------------------------------------
IPFS__MAX_UPLOAD_SIZE_BYTES=104857600
IPFS__MAX_READ_SIZE_BYTES=5242880
IPFS__PUBLIC_GATEWAY_URL=https://ipfs.io

# --- Downloader (add_file_from_url) ------------------------------------------
DOWNLOADER__REQUEST_TIMEOUT=5m
DOWNLOADER__ALLOW_PRIVATE_NETWORKS=false
